{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"],
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "taskflow": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/fraunces/full.css",
              "node_modules/@fontsource/ibm-plex-sans/400.css",
              "node_modules/@fontsource/ibm-plex-sans/500.css",
              "node_modules/@fontsource/ibm-plex-sans/600.css",
              "node_modules/@fontsource/ibm-plex-mono/400.css",
              "src/styles/tokens/primitivos.css",
              "src/styles/tokens/semanticos.css",
              "src/styles/tokens/componentes.css",
              "src/styles/componentes/inputs.css",
              "src/styles/componentes/overlays.css",
              "src/styles/componentes/tooltip.css",
              "src/styles/base.css"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/app/pages/kitchen-sink/kitchen-sink.routes.ts",
                  "with": "src/app/pages/kitchen-sink/kitchen-sink.routes.production.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "360kB",
                  "maximumError": "370kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "taskflow:build:production"
            },
            "development": {
              "buildTarget": "taskflow:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "providersFile": "src/test-providers.ts"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  }
}
